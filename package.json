{
  "name": "react-d3-webapp",
  "version": "0.9.0",
  "author": "Rolando Ramos",
  "description": "React + D3 Web Application for visualizing source control data",
  "type": "module",
  "main": "src/dist/backend/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
